{
  "name": "@money/core",
  "version": "1.0.0",
  "description": "화면이 아닌 것 전부. 웹과 앱이 함께 쓴다 (API 클라이언트, 계산, 서식, 사전, 스토어).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lib/i18n": {
      "types": "./dist/lib/i18n/index.d.ts",
      "default": "./dist/lib/i18n/index.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./data/*": {
      "types": "./dist/data/*.d.ts",
      "default": "./dist/data/*.js"
    },
    "./store/*": {
      "types": "./dist/store/*.d.ts",
      "default": "./dist/store/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@money/types": "workspace:*",
    "axios": "^1.6.0",
    "js-cookie": "^3.0.0",
    "zustand": "^4.4.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^18.0.0",
    "react": "^18.3.0",
    "typescript": "^5.3.0"
  }
}

{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // next 는 dist 가 아니라 .next 에 쌓는다. 루트 설정(dist/**)만 두면 캐시에
    // 담을 파일을 못 찾아 경고가 나고, 다음 실행에서 캐시 적중으로 빌드를
    // 건너뛰면서 아무것도 복원하지 못한다.
    //
    // .next/cache 는 next 가 다음 빌드를 빠르게 하려고 쓰는 임시 파일이라 뺀다.
    // 담아 두면 캐시가 수백 MB로 불어난다.
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    }
  }
}

NEXT_PUBLIC_API_URL=http://localhost:3001

# Google OAuth (API의 GOOGLE_CLIENT_IDS 중 웹 클라이언트 ID와 동일한 값)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Firebase Analytics (앱과 같은 Firebase 프로젝트의 웹 앱). 넷 중 하나라도 비면 통계를 보내지 않는다.
# Firebase 콘솔 → 프로젝트 설정 → 내 앱 → 웹 앱의 firebaseConfig 값.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bboyong-cecf1
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

// 복식부기 기반 스키마 (new.md 재설계안 반영)
//
// 핵심 원칙
//  1. 신용카드는 결제 수단이 아니라 부채 계정이다.
//  2. 잔액은 캐시이고, 근거는 Posting 합계다. 드리프트를 쿼리로 검증할 수 있어야 한다.
//  3. Account(잔액/소유자)와 Category(계층)는 물리적으로 분리하되, 둘 다 Posting의 대상이 된다.
//  4. 지출/수입의 정의는 결제수단과 무관하다. "지출 = 지출 카테고리 posting의 합".
//  5. 평가손익(환율, 시가)은 전표화하지 않는다.
//
// 부호 규칙 (하나의 JournalEntry 안에서 Posting.amount 합계는 항상 0)
//  자산(deposit, savings, cash, investment, real_estate) : 증가 +, 감소 -
//  부채(credit_card, loan)                                : 빚 증가 -, 상환 +
//  지출 카테고리                                          : 지출 발생 +
//  수입 카테고리                                          : 수입 발생 -

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────
// Enum
// ─────────────────────────────────────────────

enum AccountType {
  deposit // 예금/입출금
  savings // 저축
  investment // 투자 (주식, 펀드 등)
  cash // 현금
  credit_card // 신용카드 부채
  loan // 대출
  real_estate // 부동산
  // 자본 계정. 계좌 개설 시점의 잔액을 전표화할 때 상대편으로 쓴다.
  // 자산이 아니므로 순자산 합계에서 반드시 제외한다.
  opening_balance
}

// 금융기관의 용도. 계좌 개설 기관과 카드 발급사는 이름이 다른 별개 항목이라
// (예: 신한은행 / 신한카드) 한 테이블 안에서 type으로 나눈다.
enum FinancialInstitutionType {
  bank // 계좌를 개설하는 기관. 은행, 증권사, 저축은행, 상호금융을 모두 포함한다.
  card_issuer // 카드 발급사
}

enum CardType {
  debit
  credit
}

enum CategoryType {
  income
  expense
}

enum ProjectRole {
  owner
  editor
  viewer
}

enum InvitationStatus {
  pending
  accepted
  declined
  expired
}

enum JoinRequestStatus {
  pending
  approved
  rejected
}

// ─────────────────────────────────────────────
// 계정 / 프로젝트 (기존 유지)
// ─────────────────────────────────────────────

// 앱 사용자 (계정)
model User {
  id               String  @id @default(cuid())
  email            String  @unique
  googleId         String  @unique // Google ID 토큰의 sub 클레임
  name             String
  avatar           String?
  defaultProjectId String?

  // 화면 언어 ('ko' | 'en' | 'ja'). 값의 목록은 @money/types의 SUPPORTED_LOCALES가 갖는다.
  // enum으로 두지 않는 것은 언어를 하나 더할 때마다 마이그레이션이 필요해지기 때문이다.
  locale String @default("ko")

  projectMembers      ProjectMember[]
  projectInvitations  ProjectInvitation[]
  projectJoinRequests ProjectJoinRequest[]
  createdEntries      JournalEntry[] // 입력자 추적용 (조회 필터로는 쓰지 않는다)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([defaultProjectId])
}

// 프로젝트 (가계부 단위). 프로젝트 안의 데이터는 모든 멤버가 공유한다.
model Project {
  id              String  @id @default(cuid())
  projectKey      String? @unique // 검색해서 가입 요청할 때 쓰는 공유용 키
  name            String
  description     String?
  // 통화가 둘이다. 하나는 저장, 하나는 표시.
  //
  // ledgerCurrency 는 Posting.baseAmount 가 담긴 통화다. 만든 뒤 바뀌지 않는다.
  // 통화가 섞인 전표의 균형을 판정하고, 거래 시점에 실제로 청구된 금액을 그대로
  // 담는 자리라 나중에 다시 계산하면 안 된다 (원화 카드의 달러 결제에서 ₩69,000은
  // 환산값이 아니라 카드사가 청구한 실제 금액이다).
  //
  // displayCurrency 는 리포트를 어느 통화로 볼지다. 언제든 바꿀 수 있고 바꿔도
  // 저장된 값은 하나도 건드리지 않는다. 읽을 때 합계에 환율을 한 번 곱할 뿐이라
  // 몇 번을 오가도 원본이 그대로다.
  ledgerCurrency  String  @default("KRW")
  displayCurrency String  @default("KRW")
  // 집계 기준 타임존. 월 합계와 카드 청구주기 경계를 이 타임존의 벽시계로 계산한다.
  // 구성원마다 다르면 같은 가계부에서 서로 다른 월 합계를 보게 되므로 프로젝트 단위로 둔다.
  timezone        String  @default("Asia/Seoul")

  /// 이 프로젝트의 변경 번호 발급기. 쓰기 트랜잭션 안에서 1씩 오른다.
  ///
  /// 기기는 "내가 마지막으로 본 번호"를 들고 와 그 뒤의 변경만 받는다. updatedAt으로는
  /// 이 일을 할 수 없다. 기기 시계가 틀리고, 같은 밀리초가 겹치며, 커밋 순서와
  /// 타임스탬프 순서가 어긋나 변경을 건너뛴다.
  ///
  /// 번호를 이 행에서 발급하면 UPDATE가 행 잠금을 잡아 그 프로젝트의 쓰기가
  /// 직렬화된다. 그래서 번호 순서와 커밋 순서가 같아지고, 커서가 아직 커밋되지 않은
  /// 번호를 뛰어넘는 일이 없다. 한 가정의 쓰기 빈도에서 이 잠금은 비용이 아니다.
  ///
  /// Int인 이유: 하루 100건을 써도 2^31에 닿으려면 5만 년이 넘는다. BigInt로 두면
  /// JSON 직렬화가 막히고(JSON.stringify는 bigint를 던진다) 기기의 SQLite와
  /// 자바스크립트에서도 다루기가 번거로워진다.
  syncVersion    Int @default(0)
  /// 이 행 자신이 마지막으로 바뀐 번호. 아래 동기화 대상 모델이 모두 갖는다.
  updatedVersion Int @default(0)

  members        ProjectMember[]
  invitations    ProjectInvitation[]
  joinRequests   ProjectJoinRequest[]
  people         Person[]
  accounts       Account[]
  categories     Category[]
  tags           Tag[]
  cards          Card[]
  entries        JournalEntry[]
  budgets        Budget[]
  institutions   FinancialInstitution[]
  exchangeRates  ExchangeRate[]
  /// 보관함의 거래 후보. 거래가 아니라 "적을 수 있는 것"의 목록이다.
  entryDrafts    EntryDraft[]
  /// 반복 등록. 정해 둔 날마다 보관함에 후보를 만든다.
  recurringRules RecurringRule[]
  /// 자리표를 어디까지 지웠는가. 없으면 아직 한 번도 지우지 않은 것이다(0과 같다).
  tombstoneFloor TombstoneFloor?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(editor)
  // 이 사용자가 이 프로젝트에서 "나"로 쓰는 구성원.
  // Person에 userId를 두지 않는 이유: 한 프로젝트에 여러 로그인 사용자가 있을 수 있고,
  // 각자 다른 Person을 자기로 지정할 수 있어야 한다.
  personId  String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  person  Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  /// 변경 피드가 보는 번호. Project.syncVersion 에서 발급된다.
  updatedVersion Int @default(0)

  joinedAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@index([personId])
  @@index([projectId, updatedVersion])
}

// 프로젝트 초대 링크 (코드를 아는 사람이 수락하면 멤버가 된다)
model ProjectInvitation {
  id             String           @id @default(cuid())
  projectId      String
  invitationCode String           @unique
  role           ProjectRole      @default(editor)
  status         InvitationStatus @default(pending)

  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy       User    @relation(fields: [invitedByUserId], references: [id])
  invitedByUserId String

  expiresAt        DateTime?
  acceptedAt       DateTime?
  acceptedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@index([invitedByUserId])
}

// 프로젝트 가입 요청 (프로젝트 키로 검색 후 요청 -> owner가 승인)
model ProjectJoinRequest {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  status    JoinRequestStatus @default(pending)
  message   String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  decidedAt       DateTime?
  decidedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 사용자-프로젝트 쌍마다 한 행. 거절 후 재요청은 이 행을 pending으로 되돌린다.
  @@unique([projectId, userId])
  @@index([projectId, status])
  @@index([userId])
}

// 사람 (가족 구성원). 계좌 소유자이자 거래 주체.
model Person {
  id           String  @id @default(cuid())
  projectId    String
  name         String
  relationship String? // 배우자, 자녀 등
  isActive     Boolean @default(true)
  /// 화면 표시 순서 (분수 색인). 이웃 사이에 값을 끼워 넣어 한 줄만 고친다.
  /// 사전순 비교가 곧 목록 순서다 (@money/types 의 rank).
  /// 비교는 바이트 순서다. 컬럼에 `COLLATE "C"` 를 박아 두었다 (20260907100000).
  sortRank     String  @default("V")

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accounts Account[]
  entries  JournalEntry[]
  members  ProjectMember[]

  /// 필드별 병합의 시계. 필드 이름 -> HLC 지도다 (@money/types 의 field-merge).
  /// 이름과 관계처럼 서로 얽히지 않은 값은 각자 늦은 편집이 이긴다 (D5).
  /// 3단계 이전에 만들어진 행은 null 이고, 그때는 어떤 명령이든 이긴다.
  fieldHlc Json?

  /// 변경 피드가 보는 번호. Project.syncVersion 에서 발급된다.
  updatedVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, isActive])
  @@index([projectId, sortRank])
  @@index([projectId, updatedVersion])
}

// ─────────────────────────────────────────────
// 계좌
// ─────────────────────────────────────────────

// 은행/카드사 목록. 기본 제공 항목과 사용자 추가 항목이 한 테이블에 같이 있고
// projectId로 구분한다. null이면 모든 프로젝트가 공유하는 기본 제공 항목이라
// 목록을 한 곳에서 갱신할 수 있고 프로젝트마다 수십 행을 복제하지 않는다.
model FinancialInstitution {
  id        String                   @id @default(cuid())
  projectId String? // null = 기본 제공. 값이 있으면 그 프로젝트 전용 사용자 추가 항목
  type      FinancialInstitutionType
  name      String
  // 목록 노출 순서. 작을수록 위. 기본 제공 항목은 주요 기관을 앞에 두고
  // 사용자 추가 항목은 0으로 들어와 이름순으로 정렬된다.
  sortOrder Int                      @default(0)
  iconPath  String? // /icons/banks/shinhan.svg 형태. null이면 아이콘 없음
  isActive  Boolean                  @default(true)

  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accounts Account[]
  cards    Card[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 프로젝트 전용 항목의 중복 방지. projectId가 null인 기본 제공 항목은
  // Postgres가 NULL을 서로 다른 값으로 취급해 이 제약이 걸리지 않으므로
  // 마이그레이션에서 부분 유니크 인덱스를 따로 만든다.
  @@unique([projectId, type, name])
  @@index([type, isActive, sortOrder])
}

model Account {
  id            String      @id @default(cuid())
  projectId     String
  ownerId       String? // Person. opening_balance 같은 시스템 계정은 null
  type          AccountType
  name          String
  // 개설 기관. 현금/부동산 계정에는 없고, 카드 부채 계정도 발급사는 Card쪽에 있으므로 null.
  institutionId String?
  accountNumber String?
  currency      String      @default("KRW")
  // 캐시된 잔액. 근거는 Posting.amount 합계이며 6절 검증 쿼리로 대조한다.
  balance       Decimal     @default(0) @db.Decimal(19, 4)
  isActive      Boolean     @default(true)
  /// 화면 표시 순서 (분수 색인). 이웃 사이에 값을 끼워 넣어 한 줄만 고친다.
  /// 사전순 비교가 곧 목록 순서다 (@money/types 의 rank).
  /// 비교는 바이트 순서다. 컬럼에 `COLLATE "C"` 를 박아 두었다 (20260907100000).
  sortRank      String      @default("V")

  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner            Person?               @relation(fields: [ownerId], references: [id])
  institution      FinancialInstitution? @relation(fields: [institutionId], references: [id])
  investmentDetail InvestmentDetail?
  valuations       AssetValuation[]
  postings         Posting[]
  cardsAsPayment   Card[]                @relation("CardPaymentAccount")
  cardAsLiability  Card?                 @relation("CardLiabilityAccount")

  /// 필드별 병합의 시계. 필드 이름 -> HLC 지도다 (@money/types 의 field-merge).
  /// 이름과 관계처럼 서로 얽히지 않은 값은 각자 늦은 편집이 이긴다 (D5).
  /// 3단계 이전에 만들어진 행은 null 이고, 그때는 어떤 명령이든 이긴다.
  fieldHlc Json?

  /// 변경 피드가 보는 번호. Project.syncVersion 에서 발급된다.
  updatedVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, ownerId, isActive])
  @@index([projectId, updatedVersion])
  @@index([projectId, type])
  @@index([institutionId])
  @@index([projectId, sortRank])
}

// 투자성 계좌(investment, real_estate)에만 존재하는 위성 테이블
model InvestmentDetail {
  accountId  String  @id
  assetClass String // stock, fund, real_estate, gold
  ticker     String? // 주식 종목코드. 부동산은 null
  // 캐시된 보유 수량. 근거는 Posting.quantity 합계.
  quantity   Decimal @default(0) @db.Decimal(19, 8)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// 시가/감정가 스냅샷. 거래가 아니라 외부 평가값이므로 Posting을 만들지 않는다.
model AssetValuation {
  id          String   @id @default(cuid())
  accountId   String
  date        DateTime @db.Date
  quantity    Decimal  @db.Decimal(19, 8)
  price       Decimal  @db.Decimal(19, 4)
  marketValue Decimal  @db.Decimal(19, 4)
  source      String   @default("manual")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// 변경 피드가 보는 번호. 계좌를 거쳐 프로젝트를 찾는다 (BudgetOverride 와 같은 방식).
  updatedVersion Int @default(0)

  createdAt DateTime @default(now())

  @@unique([accountId, date])
  @@index([updatedVersion])
}

// ─────────────────────────────────────────────
// 카테고리
// ─────────────────────────────────────────────

// 대분류는 parentId = null, 소분류는 대분류 ID.
// level 컬럼은 두지 않는다 (parentId 체인에서 유도 가능).
model Category {
  id        String       @id @default(cuid())
  projectId String
  name      String
  parentId  String?
  type      CategoryType
  icon      String?
  isDefault Boolean      @default(false) // "선택안함" 등 삭제 불가 항목
  /// 화면 표시 순서 (분수 색인). 같은 부모 안에서만 의미가 있다.
  /// 사전순 비교가 곧 목록 순서다 (@money/types 의 rank).
  /// 비교는 바이트 순서다. 컬럼에 `COLLATE "C"` 를 박아 두었다 (20260907100000).
  sortRank  String       @default("V")

  project  Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryHierarchy")
  postings Posting[]
  budgets  Budget[]

  /// 필드별 병합의 시계. 필드 이름 -> HLC 지도다 (@money/types 의 field-merge).
  fieldHlc Json?

  /// 변경 피드가 보는 번호. Project.syncVersion 에서 발급된다.
  updatedVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 소분류 전용 제약이다. 대분류는 parentId가 NULL이라 Postgres가 NULL을 서로
  // 다른 값으로 보고 이 인덱스를 통과시킨다. 대분류 중복은 마이그레이션의
  // 부분 유니크 인덱스가 막는다:
  //   CREATE UNIQUE INDEX "Category_project_root_type_name_key"
  //     ON "Category"("projectId", "type", "name") WHERE "parentId" IS NULL;
  //
  // 지운 이름은 아무것도 막지 않는다. 지우기가 행을 **정말 지우기** 때문이다 --
  // 감춰 두는 자리가 없어졌다(20260919150000_no_hidden_rows).
  @@unique([projectId, name, parentId])
  @@index([projectId, type])
  @@index([projectId, updatedVersion])
  @@index([parentId])
  @@index([projectId, sortRank])
}

// ─────────────────────────────────────────────
// 태그
// ─────────────────────────────────────────────

/// 거래에 자유롭게 붙이는 이름표.
///
/// 카테고리와 나란히 서지만 **계층이 없다.** 카테고리는 "이 돈이 무엇에 쓰였나"를
/// 한 갈래로 정하는 것이라 대분류/소분류로 좁혀 가고 전표당 하나(분할이면 다리마다
/// 하나)다. 태그는 그와 직교하는 이름표라 "여행이면서 경조사"가 성립하고, 그래서
/// 전표 하나에 여럿 붙는다.
///
/// 수입/지출 구분(type)도 두지 않는다. 같은 여행에 항공권 지출과 환불 수입이 함께
/// 들므로, 유형으로 갈라 두면 한 여행을 두 태그로 적게 된다.
model Tag {
  id        String  @id @default(cuid())
  projectId String
  name      String
  /// 목록에서 알아보는 색. 카드와 같은 규칙(#RRGGBB)이고, 정하지 않으면 null 이다.
  color     String?
  /// 화면 표시 순서 (분수 색인). 사전순 비교가 곧 목록 순서다 (@money/types 의 rank).
  /// 비교는 바이트 순서다. 컬럼에 `COLLATE "C"` 를 박아 두었다 (20260907100000).
  sortRank  String  @default("V")

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entries EntryTag[]
  /// 후보와 반복 등록에 붙은 자리. 태그를 지우면 그 연결도 함께 사라진다(Cascade).
  drafts  EntryDraftTag[]
  rules   RecurringRuleTag[]

  /// 필드별 병합의 시계. 필드 이름 -> HLC 지도다 (@money/types 의 field-merge).
  fieldHlc Json?

  /// 변경 피드가 보는 번호. Project.syncVersion 에서 발급된다.
  updatedVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId, updatedVersion])
  @@index([projectId, sortRank])
}

/// 목록 한 줄에 붙은 태그.
///
/// **줄에 붙이고 전표에 붙이지 않는다.** 10,000원을 식비 5,000 + 여행경비 5,000으로
/// 나눴다면 "여행"은 여행경비 줄의 사실이지 결제 전체의 사실이 아니다. 전표에 붙이면
/// 두 줄에 같은 태그가 늘 함께 떠서, 태그로 좁힌 화면이 식비까지 데려온다.
///
/// 줄은 `(entryId, lineKey)` 로 가리킨다. `postingId` 가 아닌 까닭은 Posting.lineKey 참고.
///
/// `lineKey` 가 null 인 행은 **분류 줄이 없는 전표**의 것이다 -- 이체와 카드 대금
/// 결제가 그렇고, 목록도 그 둘을 한 줄로 보여 준다. 지출·수입에는 만들지 않는다.
///
/// 이 표에는 번호(updatedVersion)를 붙이지 않는다. 전표가 다리와 함께 한 단위로
/// 움직이는 것과 같은 이유다(설계 문서의 D5) -- 전표가 바뀌면 그 전표의 태그 연결을
/// 통째로 갈아 끼우고, 변경 피드도 전표에 실어 함께 보낸다.
model EntryTag {
  /// 대리 키. 줄 키가 null 일 수 있어 복합 기본키를 쓸 수 없다.
  id      String  @id @default(cuid())
  entryId String
  lineKey String?
  tagId   String

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag   Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  /// 한 줄에 같은 태그를 두 번 붙이지 않는다.
  ///
  /// null 인 줄 키는 이 제약에 걸리지 않으므로(Postgres는 null을 서로 다르게 본다),
  /// 그쪽은 마이그레이션이 부분 유니크 색인으로 따로 막는다.
  @@unique([entryId, lineKey, tagId])
  @@index([entryId])
  @@index([tagId])
}

// ─────────────────────────────────────────────
// 카드
// ─────────────────────────────────────────────

// credit: accountId가 이 카드의 부채 Account (카드 1장 = Account 1개, 앱 레이어에서 함께 생성)
// debit : accountId가 즉시 출금되는 예금 Account
model Card {
  id                  String    @id @default(cuid())
  projectId           String
  // 사용자가 반드시 고르는 실제 통장.
  // 체크카드는 결제 즉시, 신용카드는 결제일에 여기서 돈이 빠진다.
  paymentAccountId    String
  // 신용카드 사용액(= 카드사에 갚아야 할 돈)을 담는 부채 계정.
  // 카드 등록 시 자동으로 함께 만든다. 체크카드는 빚이 생기지 않으므로 null.
  // 사용자에게는 통장 목록이 아니라 카드 화면의 "사용액"으로만 보인다.
  liabilityAccountId  String?   @unique
  name                String
  cardType            CardType
  issuerId            String // 카드사. FinancialInstitution(type = card_issuer)
  cardNumber          String? // 서버에서 마스킹
  expiryDate          DateTime?
  creditLimit         Decimal?  @db.Decimal(19, 4) // credit만 사용
  // 혜택(무이자·할인 등) 조건이 되는 한 주기 사용액 기준. 카드사가 말하는 "실적".
  // 신용카드는 마감일 기준 청구 주기로, 체크카드는 달력 월로 센다.
  // null이면 이 카드에는 실적 조건이 없다는 뜻이라 화면에 아무것도 보이지 않는다.
  performanceAmount   Decimal?  @db.Decimal(19, 4)
  statementClosingDay Int? // 마감일 1~31. credit만 사용
  paymentDueDay       Int? // 결제일 1~31. credit만 사용
  // 카드 앞면 색 열쇠말(@money/types의 CardColor). 실제 색은 화면이 정한다.
  // null이면 카드 종류의 기본색(신용 파랑, 체크 초록)으로 그린다.
  color               String?
  isActive            Boolean   @default(true)
  /// 화면 표시 순서 (분수 색인). 이웃 사이에 값을 끼워 넣어 한 줄만 고친다.
  /// 사전순 비교가 곧 목록 순서다 (@money/types 의 rank).
  /// 비교는 바이트 순서다. 컬럼에 `COLLATE "C"` 를 박아 두었다 (20260907100000).
  sortRank            String    @default("V")

  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issuer           FinancialInstitution @relation(fields: [issuerId], references: [id])
  paymentAccount   Account              @relation("CardPaymentAccount", fields: [paymentAccountId], references: [id])
  liabilityAccount Account?             @relation("CardLiabilityAccount", fields: [liabilityAccountId], references: [id])
  statements       CardStatement[]
  postings         Posting[] // 표시/분석용. 잔액에는 영향 없음 (계정측 posting이 이미 처리)

  /// 필드별 병합의 시계. 필드 이름 -> HLC 지도다 (@money/types 의 field-merge).
  /// 이름과 관계처럼 서로 얽히지 않은 값은 각자 늦은 편집이 이긴다 (D5).
  /// 3단계 이전에 만들어진 행은 null 이고, 그때는 어떤 명령이든 이긴다.
  fieldHlc Json?

  /// 변경 피드가 보는 번호. Project.syncVersion 에서 발급된다.
  updatedVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, isActive])
  @@index([projectId, updatedVersion])
  @@index([paymentAccountId])
  @@index([issuerId])
  @@index([projectId, sortRank])
}

// 신용카드 청구서 (한 결제 주기)
model CardStatement {
  id          String   @id @default(cuid())
  cardId      String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date // 마감일
  dueDate     DateTime @db.Date // 결제일
  // status 컬럼은 두지 않는다. (마감일, 청구액 합계, 결제액 합계)에서 유도되는 값이라
  // 저장하면 잔액 캐시와 같은 드리프트가 생긴다. 서비스에서 계산해 응답에 담는다.

  card     Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  postings Posting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cardId, periodEnd])
  @@index([cardId, dueDate])
}

// ─────────────────────────────────────────────
// 할부
// ─────────────────────────────────────────────

// 원금은 구매 즉시 전액 부채로 잡힌다. 아래 표는 "언제 얼마가 청구되는지"의 일정표일 뿐
// 새로운 Posting을 만들지 않는다. 수수료만 전표로 남는다 (실제로 나가는 돈이 늘어서다).
model InstallmentPlan {
  id          String @id @default(cuid())
  postingId   String @unique // 원 구매의 카드측 posting
  totalMonths Int

  /// 수수료가 붙는 할부인가.
  ///
  /// 회차 금액은 원금을 개월수로 나눈 값이라 계산으로 얻지만, 수수료는 카드사마다
  /// 다르고 회차마다 조금씩 달라 계산으로 맞출 수 없다. 그래서 유이자로 적은 할부는
  /// 마감된 회차마다 "수수료 미입력"으로 떠오르고, 사용자가 명세서를 보고 적으면 그때
  /// 수수료 전표가 생긴다 (환율 확정과 같은 손짓이다).
  ///
  /// 이 값이 없던 때에 적은 할부는 무이자로 본다. 수수료 전표가 없다는 뜻이라 그때까지의
  /// 숫자가 그대로 남는다.
  interestBearing Boolean @default(false)

  /// 사용자가 적어 둔 회차별 원금. 문자열 배열이고, 적지 않았으면 null 이다.
  ///
  /// 끝수를 어느 회차에 몰아주는지가 카드사마다 다르다. 1,000원 3개월이 334/333/333 일
  /// 수도 334/334/332 일 수도 있어, 계산만으로는 명세서와 맞출 수 없는 자리가 있다.
  ///
  /// null 이면 총액을 개월수로 나눈다(`installmentPrincipals`). 금액이나 개월수를 고치면
  /// 이 값을 버리고 다시 나눈다 -- 길이나 합이 어긋난 옛 값이 남으면 주기별 청구액이
  /// 갚을 대금과 달라진다.
  principalShares Json?

  posting Posting        @relation(fields: [postingId], references: [id], onDelete: Cascade)
  fees    JournalEntry[] @relation("InstallmentFee")

  /// 변경 피드가 보는 번호. 다리와 전표를 거쳐 프로젝트를 찾는다.
  ///
  /// 회차는 표로 두지 않는다. 원금 회차는 총액과 개월수에서 다시 계산되는 파생값이고
  /// (설계 문서의 D7), 수수료는 전표로 남는다 -- 전표 합이 곧 카드 부채라 수수료만
  /// 따로 적어 두면 갚을 대금과 원장이 어긋난다.
  updatedVersion Int @default(0)

  createdAt DateTime @default(now())

  @@index([updatedVersion])
}

// ─────────────────────────────────────────────
// 원장
// ─────────────────────────────────────────────

// 하나의 경제적 사건. 소속 Posting.amount 의 합은 항상 0이어야 한다.
model JournalEntry {
  id           String   @id @default(cuid())
  projectId    String
  personId     String // 거래 주체
  date         DateTime
  description  String // 거래 설명
  merchant     String? // 거래처 (가맹점, 송금 계좌주 등)
  detailedNote String? // 상세설명

  // 원화 카드로 외화 결제를 했을 때의 원 통화 금액. 표시 전용이다.
  //
  // 이 경우 청구되는 돈은 원화이므로 원장(posting)은 전부 원화로 남는다.
  // 그런데 "$50 결제"라는 사실이 사라지면 카드 명세서와 대조할 수 없어서
  // 전표에 함께 적어 둔다. 계좌 자체가 외화인 경우는 이 필드를 쓰지 않는다
  // (그때는 posting.currency 가 외화다).
  originalCurrency String?
  originalAmount   Decimal? @db.Decimal(19, 4)

  // 환산액이 서버 추정 환율로 만들어졌다는 표시.
  //
  // 원화 카드로 외화를 결제하면 실제 청구액은 결제일에야 정해진다. 카드사가
  // 자기 환율에 수수료를 얹기 때문이다. 그래서 일단 추정으로 적어 두고,
  // 명세서가 나오면 실제 청구액으로 고쳐 확정한다(그때 false가 된다).
  //
  // 원 통화 금액이 남는 거래에만 붙인다. 외화 계좌 거래는 계좌 통화 금액이
  // 이미 사실이라 확정할 것이 없고, 사용자가 환율을 직접 넣은 거래도 마찬가지다.
  rateProvisional Boolean @default(false)

  // 이 거래를 카드 실적에 세는가. 카드로 낸 거래에만 뜻이 있다.
  //
  // 실적과 청구액은 다른 값이다. 카드사는 갚아야 할 돈과 별개로 "이번 주기에 얼마
  // 썼나"를 따로 세고, 세금·공과금·상품권처럼 청구는 되지만 실적에서 빠지는 결제가
  // 있다. 반대로 카드사가 되돌려 준 돈은 빚을 줄이되 실적까지 깎지 않는 것이 보통이다.
  //
  // **분할해도 하나다.** 실적을 세는 쪽은 카드사이고 그쪽이 보는 것은 승인 한 건이라,
  // 한 결제를 분류로 나눴다고 절반만 실적에 드는 일은 없다.
  //
  // 기본값이 갈래마다 다르다 -- 지출은 포함, 카드로 들어온 수입은 제외다. 그 판단은
  // 조립(entry-build)이 하고 여기에는 정해진 값만 담긴다.
  //
  // 카드가 끼지 않은 거래는 true 로 둔다. 실적 질의가 카드 다리만 보므로 읽히지 않는다.
  countsPerformance Boolean @default(true)

  // 차감·취소 금액을 카드 실적에서도 뺄지.
  //
  // 다리에는 이미 깎인 뒤의 금액이 들어가 있어, 이 값이 true 면 실적도 그만큼 줄어든다.
  // false 면 실적만 정가로 센다 -- 갚을 대금은 어느 쪽이든 깎인 금액 그대로다.
  //
  // **분할해도 하나다.** 깎인 금액은 줄마다 따로 적지만(Posting.discountAmount),
  // "그것을 실적에서 뺄지"는 카드사의 방침 하나라 줄마다 갈릴 값이 아니다.
  //
  // 차감이 없는 거래와 countsPerformance 가 꺼진 거래에서는 읽히지 않는다.
  discountCountsPerformance Boolean @default(true)

  createdByUserId String? // 입력자 추적용. 조회 필터로 쓰지 않는다 (프로젝트 멤버는 모두 같은 데이터를 본다)

  /// 이 전표가 메우는 할부 회차. **수수료 전표에만** 있다.
  ///
  /// 유이자 할부는 회차마다 수수료가 붙고 금액이 조금씩 다르다. 사용자가 명세서를 보고
  /// 적으면 그 주기 결제일에 수수료 전표 하나가 생기는데, 어느 회차를 이미 적었는지
  /// 알아야 같은 회차가 다시 떠오르지 않는다. 그 표가 이 두 칸이다.
  ///
  /// 계획이 사라져도(원 구매를 지우면 다리와 함께 지워진다) 전표는 남는다. 그 수수료는
  /// 실제로 나간 돈이라, 지우면 통장과 원장이 어긋난다.
  installmentPlanId   String?
  installmentSequence Int?

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  person          Person           @relation(fields: [personId], references: [id])
  createdBy       User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  installmentPlan InstallmentPlan? @relation("InstallmentFee", fields: [installmentPlanId], references: [id], onDelete: SetNull)
  postings        Posting[]
  tags            EntryTag[]
  /// 이 전표를 만들어 낸 보관함 후보. 대개 없다 (손으로 적은 거래).
  drafts          EntryDraft[]

  /// 변경 피드가 보는 번호. Project.syncVersion 에서 발급된다.
  updatedVersion Int @default(0)

  /// 이 전표를 마지막으로 고친 편집의 하이브리드 논리 시계 (@money/types 의 hlc.ts).
  ///
  /// 두 기기가 같은 전표를 각자 고쳤을 때 어느 쪽이 이기는지를 이 값으로 정한다.
  /// 전표는 다리까지 통째로 한 단위라 필드별 병합을 쓸 수 없다 (설계 문서의 D5).
  /// 2단계 이전에 만들어진 전표는 null 이고, 그때는 어떤 편집이든 이긴다.
  updatedHlc String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 한 회차의 수수료는 한 번만 적는다. 두 기기가 같은 회차를 동시에 확정하면 뒤엣것이 막힌다.
  @@unique([installmentPlanId, installmentSequence])
  // 커서 페이지네이션 (date desc, id desc)
  @@index([projectId, date, id])
  @@index([projectId, updatedVersion])
  @@index([projectId, personId, date])
  @@index([createdByUserId])
}

// 전표의 개별 다리(leg). accountId 와 categoryId 중 정확히 하나만 채운다.
// DB CHECK 제약은 Prisma가 표현하지 못하므로 마이그레이션에 raw SQL로 추가한다:
//   ALTER TABLE "Posting" ADD CONSTRAINT posting_target_exclusive
//     CHECK (("accountId" IS NULL) != ("categoryId" IS NULL));
model Posting {
  id           String   @id @default(cuid())
  entryId      String
  accountId    String?
  categoryId   String?
  amount       Decimal  @db.Decimal(19, 4)
  quantity     Decimal? @db.Decimal(19, 8) // 투자 계좌 posting에서만 사용 (매수/매도 수량)
  currency     String   @default("KRW")
  baseAmount   Decimal  @db.Decimal(19, 4) // 프로젝트 기준통화 환산액
  exchangeRate Decimal  @default(1) @db.Decimal(19, 8)
  statementId  String? // 신용카드 posting만 사용
  cardId       String? // 표시/분석용. 체크카드 사용 시에도 채운다

  /// 이 줄의 신원. **분류 다리에만 채운다** (계좌 다리는 null).
  ///
  /// id 로는 줄을 가리킬 수 없다. 전표를 고칠 때마다 다리를 통째로 지우고 새로
  /// 만들기 때문에(`LedgerService.replaceEntry`), 분류와 무관한 사소한 수정에도
  /// 모든 posting 의 id 가 바뀐다. 그래서 줄에 붙는 것(태그·차감)이 id 를 가리키면
  /// 한 번의 수정으로 전부 끊긴다.
  ///
  /// **화면이 만들어 편집 내내 들고 다닌다.** 분할 줄을 더하는 순간 uuid 를 붙이고,
  /// 저장할 때마다 그대로 되돌려 보낸다. 서버는 옛 값과 새 값을 짝지을 필요 없이
  /// 받은 값을 그대로 써 넣는다. 오프라인에서도 같은 길이다.
  ///
  /// 이체 수수료도 분류 다리라 키를 갖는다. 목록은 이체를 한 줄로 보여 주지만,
  /// 그 줄의 신원이 갈래마다 다르면 규칙이 두 벌이 된다.
  lineKey String?

  /// 이 줄에서 깎인 금액 (포인트·자동할인·취소). 양수이고 **분류 다리에만** 있다.
  ///
  /// 통화는 사용자가 적은 통화다 (정가와 같은 칸에서 뺀 값이라 그렇다).
  /// `amount` 는 이미 이 값을 뺀 순액이라, 편집 화면이 정가 칸을 되살릴 때 둘을 더한다.
  ///
  /// 예전에는 전표에 하나만 두고 줄마다 비율로 나눴다. 여행경비만 환불받아도 식비 줄이
  /// 함께 깎여 분류별 분석이 사실과 어긋났다.
  ///
  /// **실적 여부는 여기 없다.** 깎인 금액은 줄마다 다르지만 "그것을 실적에서 뺄지"는
  /// 카드사의 방침 하나라 전표에 둔다 (JournalEntry.discountCountsPerformance).
  ///
  /// 한 값만 담는다. 여러 번의 부분 환불을 시점별로 남기는 이력은 다른 요구사항이다.
  discountAmount Decimal? @db.Decimal(19, 4)

  entry           JournalEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account         Account?         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  statement       CardStatement?   @relation(fields: [statementId], references: [id], onDelete: SetNull)
  card            Card?            @relation(fields: [cardId], references: [id], onDelete: SetNull)
  installmentPlan InstallmentPlan?

  /// 한 전표 안에서 줄 키는 겹치지 않는다. 계좌 다리의 null 은 서로 다른 값으로
  /// 취급되어(Postgres) 여러 개가 함께 있어도 걸리지 않는다.
  @@unique([entryId, lineKey])
  @@index([entryId])
  @@index([accountId, entryId])
  @@index([categoryId])
  @@index([statementId])
  @@index([cardId])
}

// ─────────────────────────────────────────────
// 환율
// ─────────────────────────────────────────────

/// 프로젝트가 쓰는 환율.
///
/// 프로젝트마다 따로 둔다. 환율은 시세이기도 하지만 "우리 가계부가 어떤 값으로
/// 환산할지"라는 선택이기도 해서, 한 가계부에서 바꾼 값이 다른 가계부의 과거
/// 리포트까지 흔들면 안 된다.
///
/// 행이 없으면 서버가 들고 있는 기본값(ExchangeRatesService.FALLBACK_RATES)을 쓴다.
model ExchangeRate {
  id            String   @id @default(cuid())
  projectId     String
  baseCurrency  String
  quoteCurrency String
  rate          Decimal  @db.Decimal(19, 8)
  date          DateTime @db.Date
  /// 'manual' = 사용자가 설정에서 넣은 값. 나중에 외부 API 연동이 붙으면 그 이름이 들어간다.
  source        String   @default("manual")

  /// 변경 피드가 보는 번호. Project.syncVersion 에서 발급된다.
  updatedVersion Int @default(0)

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, baseCurrency, quoteCurrency, date])
  @@index([projectId])
  @@index([projectId, updatedVersion])
}

// ─────────────────────────────────────────────
// 예산 (회계가 아니라 계획 개념이라 원장과 분리)
// ─────────────────────────────────────────────

model Budget {
  id            String        @id @default(cuid())
  projectId     String
  categoryId    String? // null = 전체 예산
  type          CategoryType? // categoryId가 null일 때만 사용
  monthlyAmount Decimal       @db.Decimal(19, 4)

  // 적용 기간: null이면 무기한. "YYYY-MM" 형식
  effectiveFrom String?
  effectiveTo   String?

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  overrides BudgetOverride[]

  /// 필드별 병합의 시계. 필드 이름 -> HLC 지도다 (@money/types 의 field-merge).
  fieldHlc Json?

  /// 변경 피드가 보는 번호. Project.syncVersion 에서 발급된다.
  updatedVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, categoryId, type, effectiveFrom])
  @@index([projectId, categoryId])
  @@index([projectId, updatedVersion])
}

// 예산 월별 직접 오버라이드
model BudgetOverride {
  id       String  @id @default(cuid())
  budgetId String
  year     Int
  month    Int
  amount   Decimal @db.Decimal(19, 4)

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  /// 필드별 병합의 시계. 필드 이름 -> HLC 지도다 (@money/types 의 field-merge).
  fieldHlc Json?

  /// 변경 피드가 보는 번호. 이 표에는 projectId 가 없어 부모(Budget)를 거쳐 거른다.
  updatedVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([budgetId, year, month])
  @@index([updatedVersion])
}

// ─────────────────────────────────────────────
// 변경 피드
// ─────────────────────────────────────────────

/// 지워진 행의 자리표.
///
/// 소프트 삭제(isActive = false)는 그냥 변경으로 흐르므로 여기 오지 않는다 -- 구성원과
/// 통장·카드가 그렇다. 행이 실제로 사라지는 곳(전표, 분류, 태그, 예산, 월 조정, 환율,
/// 멤버)만 남긴다. 자리표가 없으면 오프라인 기기는 "사라진 것"을 알 방법이 없어 지운
/// 것이 그 기기에 계속 남는다.
///
/// 부모가 cascade 로 함께 지워지는 자식(월 조정)은 자리표를 남기지 않는다. 부모의
/// 자리표를 받은 기기가 자기 쪽에서 함께 지우면 되고, 트리거가 부모를 다시 읽을 수도
/// 없기 때문이다(이미 사라졌다).
/// 기기가 보낸 명령의 기록. 같은 명령이 두 번 적히지 않게 한다.
///
/// 응답을 받지 못한 기기는 같은 명령을 다시 보낸다. 그때 서버가 적용했는지 못 했는지
/// 기기는 알 수 없다. 멱등 키가 없으면 그 재전송이 지출을 두 번 적는다. 가계부에서
/// 이것은 조용히 틀리는 종류의 버그다 (설계 문서의 D3).
///
/// 이 표는 동기화 대상이 아니다. 변경 피드에도 실리지 않고 도장 트리거도 걸지 않는다.
model MutationLog {
  /// 기기가 만든 명령 id (UUIDv7). 재전송해도 같은 값이다.
  mutationId     String @id
  projectId      String
  clientId       String
  /// 그 기기 안에서 1씩 오르는 번호. 순서를 지켜 적용하는 근거다.
  clientSeq      Int
  kind           String
  /// running | applied | duplicate | conflict | rejected
  ///
  /// running 은 어느 요청이 이 명령을 잡고 재생하는 중이라는 뜻이다. 행을 먼저 잡고
  /// 재생하므로, 같은 명령이 동시에 두 번 도착해도 재생은 한 번만 일어난다.
  status         String
  /// 그때 돌려준 결과. 재전송에는 이것을 그대로 돌려준다. running 인 동안은 비어 있다.
  resultJson     Json?
  /// 적용 뒤의 프로젝트 번호
  appliedVersion Int?

  /// 이 명령을 잡은 시각. 잡은 요청이 죽으면 이 시각을 보고 다른 요청이 넘겨받는다.
  claimedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@unique([clientId, clientSeq])
  @@index([projectId, createdAt])
  /// 죽은 요청이 잡아 둔 행을 골라 넘겨받을 때 쓴다.
  @@index([status, claimedAt])
}

model Tombstone {
  /// 표 이름 그대로 ("JournalEntry"). 기기가 어느 표에서 지울지 고르는 열쇠다.
  entity         String
  entityId       String
  projectId      String
  deletedVersion Int

  /// 언제 지워졌는가. 보관 기간이 지난 자리표를 골라내는 데만 쓴다.
  ///
  /// 번호(deletedVersion)로는 이 일을 할 수 없다. 번호는 프로젝트마다 다른 속도로
  /// 오르므로 "90일 지났다"를 번호로 옮길 방법이 없다. 값은 트리거가 찍는다
  /// (sync_tombstone_touch) -- 같은 id 가 다시 지워지면 시각도 함께 새로 든다.
  deletedAt DateTime @default(now())

  @@id([entity, entityId])
  @@index([projectId, deletedVersion])
  /// 보관 기간이 지난 것을 훑어 지울 때 쓴다.
  @@index([deletedAt])
}

/// 자리표를 어디까지 지웠는가. 프로젝트마다 한 줄이다.
///
/// **Project 에 두지 않은 이유가 있다.** 그 표는 UPDATE 마다 syncVersion 이 오르는
/// 트리거를 달고 있어서, 정리 작업이 값을 하나 고칠 때마다 모든 기기가 "프로젝트가
/// 바뀌었다"는 변경을 받게 된다. 정리는 기기가 볼 일이 아니다.
///
/// `version` 아래의 자리표는 이미 지워졌다는 뜻이다. 그 번호보다 오래된 커서를 든
/// 기기는 놓친 삭제를 따라잡을 수 없으므로 사본을 버리고 처음부터 받는다.
model TombstoneFloor {
  projectId String   @id
  version   Int      @default(0)
  prunedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// 보관함에 담긴 거래 후보. **전표가 아니다.**
///
/// 기기가 알림(카드 승인 문구)과 화면 캡처에서 읽어 낸 "적을 수 있는 것"을 담아 둔다.
/// 합계·잔액·예산은 이 표를 보지 않는다. 사용자가 보관함에서 눌러 저장할 때 비로소
/// JournalEntry 가 만들어지고, 그때 이 행에는 registered 표시와 그 전표의 id 만 남는다.
///
/// **필드별 병합(fieldHlc)을 두지 않는다.** 후보는 여러 사람이 같은 칸을 동시에 고칠
/// 물건이 아니고(대개 담은 기기에서 한 번 손보고 끝난다), 어긋나면 다시 읽어 담으면
/// 되는 값이다. 늦게 쓴 것이 이긴다.
///
/// 파싱한 값에 제약을 걸지 않는다. 금액만 읽히고 분류를 모르는 후보가 정상이라,
/// NOT NULL 로 묶으면 반쯤 읽힌 것을 버려야 한다 -- 사람이 한 칸 채우면 되는 것을
/// 버리는 편이 늘 더 나쁘다.
model EntryDraft {
  id        String @id @default(cuid())
  projectId String
  /// notification | capture
  source    String
  /// pending | registered | dismissed
  status    String @default("pending")

  /// 읽은 원문. 규칙이 틀렸을 때 근거가 되는 유일한 값이다.
  rawText    String
  appPackage String?
  appTitle   String?

  /// 읽어 낸 값. 확실하지 않으면 null 이다.
  kind              String?
  amount            Decimal?  @db.Decimal(18, 4)
  currency          String?
  occurredAt        DateTime?
  merchant          String?
  description       String?
  installmentMonths Int?

  /// 짐작한 연결. 화면이 바꿀 수 있다.
  personId   String?
  categoryId String?
  accountId  String?
  cardId     String?

  confidence Int     @default(0)
  parser     String?

  /// 같은 것을 두 번 담지 않기 위한 열쇠. (프로젝트, 열쇠) 가 유일하다.
  dedupeKey String

  /// 등록해서 만들어진 전표. 그 전표를 지우면 null 로 돌아온다(SetNull).
  registeredEntryId String?

  /// 이 후보를 만들어 낸 반복 등록. 알림·캡처에서 온 것은 null 이다.
  recurringRuleId String?

  /// 누가 담았는가. 알림은 그 기기의 사용자다.
  createdByUserId String?

  /// 필드별 병합의 시계 지도를 두지 않는 대신, 변경 피드의 번호는 다른 표와 같다.
  updatedVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  registeredEntry JournalEntry?   @relation(fields: [registeredEntryId], references: [id], onDelete: SetNull)
  /// 붙일 태그. 반복에서 온 후보는 그 규칙의 태그를 그대로 받는다.
  tags            EntryDraftTag[]
  /// 반복을 지워도 이미 만들어진 후보는 남는다. 사용자가 아직 처리하지 않았을 수 있다.
  recurringRule   RecurringRule?  @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  @@unique([projectId, dedupeKey])
  @@index([projectId, status, source])
  @@index([projectId, updatedVersion])
  @@index([registeredEntryId])
}

/// 반복 등록. 정해 둔 날마다 보관함에 후보를 만든다.
///
/// **거래를 만들지 않는다.** 만드는 것은 후보(EntryDraft)이고, 사용자가 보관함에서
/// 눌러야 전표가 된다. 자동으로 장부에 적히면 그 달의 합계가 사람 모르게 움직인다 --
/// 반복은 "적는 것을 잊지 않게" 하는 장치이지 "대신 적는" 장치가 아니다.
///
/// 날짜를 **문자열**로 담는다("YYYY-MM-DD"). 이 값들은 인스턴트가 아니라 프로젝트
/// 타임존의 달력 날짜다. DateTime 으로 두면 UTC 로 저장되면서 시간대에 따라 하루씩
/// 밀리고, "매월 25일"이 24일이나 26일이 되는 자리가 생긴다.
///
/// 변경 피드(updatedVersion)에 싣지 않는다. 반복은 드물게 손대는 설정이라 서버에서
/// 곧바로 읽고 쓰며(REST), 기기 사본에 두지 않는다. 만들어진 후보는 여느 후보와 같이
/// 피드를 타고 내려간다.
model RecurringRule {
  id        String  @id @default(cuid())
  projectId String
  isActive  Boolean @default(true)

  /// daily | monthly | yearly
  frequency  String
  /// daily: 며칠마다 (1 이면 매일)
  everyDays  Int?
  /// monthly·yearly: 며칟날. 그 달에 없는 날은 마지막 날로 당긴다.
  dayOfMonth Int?
  /// yearly: 몇 월
  month      Int?

  /// "YYYY-MM-DD". 프로젝트 타임존의 달력 날짜다.
  startDate String
  endDate   String?
  /// "HH:mm". 만들어질 후보의 거래 시각. 없으면 그 날 정오다.
  timeOfDay String?

  // ── 후보에 그대로 담길 값 ──
  kind              String
  amount            Decimal? @db.Decimal(18, 4)
  currency          String?
  description       String
  merchant          String?
  personId          String?
  categoryId        String?
  accountId         String?
  cardId            String?
  installmentMonths Int?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  drafts  EntryDraft[]
  /// 이 반복이 만드는 후보에 붙일 태그.
  tags    RecurringRuleTag[]

  @@index([projectId, isActive])
}

/// 후보에 붙은 태그. 전표의 EntryTag 와 같은 짜임이다.
///
/// 다리 표로 두는 것은 **태그를 지웠을 때 함께 사라지게** 하려는 것이다. id 배열로
/// 들고 있으면 지운 태그의 id 가 후보에 남고, 그 후보를 거래로 적을 때 서버가
/// TAG_NOT_IN_PROJECT 로 거절한다 -- 사람은 폼에서 그 태그를 볼 수 없어 무엇을 빼야
/// 할지 알 수 없다.
model EntryDraftTag {
  draftId String
  tagId   String

  draft EntryDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  tag   Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([draftId, tagId])
  @@index([tagId])
}

/// 반복 등록에 붙은 태그. 그 반복이 만드는 후보가 이것을 그대로 받는다.
model RecurringRuleTag {
  ruleId String
  tagId  String

  rule RecurringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  tag  Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ruleId, tagId])
  @@index([tagId])
}

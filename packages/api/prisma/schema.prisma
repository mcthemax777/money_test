datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Enum 정의
enum TransactionType {
  income
  expense
  transfer
}

enum CardType {
  debit
  credit
}

enum PaymentStatus {
  pending
  completed
}

enum ProjectRole {
  owner
  editor
  viewer
}

enum InvitationStatus {
  pending
  accepted
  declined
  expired
}

// 앱 사용자 (계정)
model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  password            String
  name                String
  avatar              String?
  defaultProjectId    String?  // 기본 프로젝트

  projectMembers      ProjectMember[]
  projectInvitations  ProjectInvitation[]
  people              Person[]
  accounts            Account[]
  cards               Card[]
  transactions        Transaction[]
  categories          Category[]
  cardUsages          CardUsage[]
  cardPayments        CardPayment[]
  budgets             Budget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([defaultProjectId])
}

// 프로젝트
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?

  members       ProjectMember[]
  invitations   ProjectInvitation[]
  people        Person[]
  accounts      Account[]
  cards         Card[]
  transactions  Transaction[]
  categories    Category[]
  cardUsages    CardUsage[]
  cardPayments  CardPayment[]
  budgets       Budget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 프로젝트 멤버
model ProjectMember {
  id        String       @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole  @default(editor)

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// 프로젝트 초대
model ProjectInvitation {
  id               String             @id @default(cuid())
  projectId        String
  email            String
  invitationCode   String             @unique
  role             ProjectRole        @default(editor)
  status           InvitationStatus   @default(pending)

  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy        User               @relation(fields: [invitedByUserId], references: [id])
  invitedByUserId  String

  expiresAt        DateTime?
  acceptedAt       DateTime?
  acceptedByUserId String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([projectId])
  @@index([email])
  @@index([status])
}

// 사람 (가족 구성원)
model Person {
  id            String   @id @default(cuid())
  projectId     String
  userId        String
  name          String
  relationship  String?  // 배우자, 자녀 등

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts      Account[]
  transactions  Transaction[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
}

// 은행 통장
model Account {
  id              String   @id @default(cuid())
  projectId       String
  userId          String
  ownerId         String   // Person ID (통장 주인)
  name            String
  accountNumber   String?  // 자동 생성되는 내부 번호
  balance         Float    @default(0)
  bankName        String
  currency        String   @default("KRW")

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  owner           Person   @relation(fields: [ownerId], references: [id])
  cards           Card[]
  transactions    Transaction[]
  cardPayments    CardPayment[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([ownerId])
  @@index([bankName])
}

// 카드 (체크카드, 신용카드)
model Card {
  id              String   @id @default(cuid())
  projectId       String
  userId          String
  accountId       String   // 연결된 통장
  name            String
  cardNumber      String?  // 서버에서 마스킹 처리
  cardType        CardType @default(debit)
  issuer          String   // 카드사
  expiryDate      DateTime?
  creditLimit     Float?   // 신용카드 한도
  currentBalance  Float?   @default(0) // 신용카드 현재 사용액

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  usages          CardUsage[]
  payments        CardPayment[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([accountId])
  @@index([cardType])
}

// 거래 (입금, 출금, 이체)
model Transaction {
  id                String   @id @default(cuid())
  projectId         String
  userId            String
  accountId         String
  personId          String   // 거래한 사람
  cardId            String?  // 카드로 거래한 경우
  type              TransactionType
  amount            Float
  description       String
  date              DateTime
  mainCategoryId    String?  // 대분류 ID
  subCategoryId     String?  // 소분류 ID
  tags              String[] @default([])
  isRecurring       Boolean  @default(false)
  recurringPattern  String?  // daily, weekly, monthly, yearly
  isFixed           Boolean  @default(false) // 고정 지출/수입 여부

  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  person            Person   @relation(fields: [personId], references: [id])
  card              Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)
  mainCategory      Category? @relation("MainCategory", fields: [mainCategoryId], references: [id], onDelete: SetNull)
  subCategory       Category? @relation("SubCategory", fields: [subCategoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([accountId])
  @@index([personId])
  @@index([cardId])
  @@index([date])
  @@index([type])
  @@index([mainCategoryId])
  @@index([subCategoryId])
  @@index([isFixed])
}

// 카테고리 (대분류/소분류)
model Category {
  id              String   @id @default(cuid())
  projectId       String
  userId          String
  name            String
  parentId        String?  // 대분류는 null, 소분류는 대분류 ID
  level           Int      @default(1) // 1: 대분류, 2: 소분류
  type            String   // income, expense
  icon            String?
  defaultIsFixed  Boolean  @default(false) // 소분류의 기본 고정 여부 (level=2일 때만 사용)
  isDefault       Boolean  @default(false) // 기본 카테고리 (예: "선택안함") - 삭제 불가

  project               Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent                Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children              Category[]    @relation("CategoryHierarchy")
  mainCategoryTrans     Transaction[] @relation("MainCategory")
  subCategoryTrans      Transaction[] @relation("SubCategory")
  budgets               Budget[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([type])
  @@index([parentId])
  @@index([isDefault])
  @@unique([projectId, userId, name, parentId])
}

// 카드 사용 기록
model CardUsage {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  cardId      String
  amount      Float
  merchant    String   // 가맹점
  date        DateTime
  status      String   @default("completed") // pending, completed, cancelled
  isPaymentDue Boolean @default(true)

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  payments    CardPaymentUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([cardId])
  @@index([date])
}

// 신용카드 결제 (신용카드 사용액을 통장에서 결제)
model CardPayment {
  id              String   @id @default(cuid())
  projectId       String
  userId          String
  cardId          String
  accountId       String
  totalAmount     Float    // 결제할 총액
  paidAmount      Float    @default(0) // 실제 결제된 금액
  status          String   @default("pending") // pending, completed
  paymentDate     DateTime
  transactionId   String?  // 결제 거래 ID

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card            Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  usages          CardPaymentUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([cardId])
  @@index([status])
}

// 신용카드 결제와 사용 기록 연결 (N:N 관계)
model CardPaymentUsage {
  id            String   @id @default(cuid())
  cardPaymentId String
  cardUsageId   String
  amount        Float    // 결제에 포함된 금액 (분할 결제 시 일부만 포함 가능)

  cardPayment   CardPayment  @relation(fields: [cardPaymentId], references: [id], onDelete: Cascade)
  cardUsage     CardUsage    @relation(fields: [cardUsageId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())

  @@unique([cardPaymentId, cardUsageId])
  @@index([cardPaymentId])
  @@index([cardUsageId])
}

// 예산 (기본 규칙)
model Budget {
  id            String   @id @default(cuid())
  projectId     String
  userId        String
  categoryId    String?  // null=전체, 값=대분류/소분류
  type          String?  // 전체 예산인 경우 'income' 또는 'expense' (categoryId가 null일 때만 사용)
  monthlyAmount Float

  // 적용 기간: null이면 무기한
  effectiveFrom String?   // "YYYY-MM" 형식
  effectiveTo   String?   // "YYYY-MM" 형식

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  overrides     BudgetOverride[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([categoryId])
  @@unique([projectId, userId, categoryId, type, effectiveFrom])
}

// 예산 월별 직접 오버라이드
model BudgetOverride {
  id        String   @id @default(cuid())
  budgetId  String
  year      Int      // 2024
  month     Int      // 8
  amount    Float

  budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([budgetId, year, month])
  @@index([budgetId])
}

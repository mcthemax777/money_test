datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 앱 사용자 (계정)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  avatar    String?

  people        Person[]
  accounts      Account[]
  cards         Card[]
  transactions  Transaction[]
  categories    Category[]
  cardUsages    CardUsage[]
  cardPayments  CardPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// 사람 (통장 주인, 가족 구성원)
model Person {
  id            String   @id @default(cuid())
  userId        String
  name          String
  role          String   @default("family_member") // owner, family_member
  relationship  String?  // 배우자, 자녀 등

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts      Account[]
  cards         Card[]
  transactions  Transaction[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([role])
}

// 은행 통장
model Account {
  id              String   @id @default(cuid())
  userId          String
  ownerId         String   // Person ID (통장 주인)
  name            String
  accountNumber   String   @unique
  balance         Float    @default(0)
  bankName        String
  accountType     String   @default("checking") // checking, savings
  currency        String   @default("KRW")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  owner           Person   @relation(fields: [ownerId], references: [id])
  cards           Card[]
  transactions    Transaction[]
  cardPayments    CardPayment[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([ownerId])
  @@index([bankName])
}

// 카드 (체크카드, 신용카드)
model Card {
  id              String   @id @default(cuid())
  userId          String
  accountId       String   // 연결된 통장
  personId        String   // 카드 사용자 (Person ID)
  name            String
  cardNumber      String   // 서버에서 마스킹 처리
  cardType        String   @default("debit") // debit, credit
  issuer          String   // 카드사
  expiryDate      DateTime
  creditLimit     Float?   // 신용카드 한도
  currentBalance  Float?   @default(0) // 신용카드 현재 사용액

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  person          Person   @relation(fields: [personId], references: [id])
  transactions    Transaction[]
  usages          CardUsage[]
  payments        CardPayment[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([accountId])
  @@index([personId])
  @@index([cardType])
}

// 거래 (입금, 출금, 이체)
model Transaction {
  id                String   @id @default(cuid())
  userId            String
  accountId         String
  personId          String   // 거래한 사람
  cardId            String?  // 카드로 거래한 경우
  type              String   // income, expense, transfer
  amount            Float
  description       String
  date              DateTime
  mainCategory      String   // 대분류
  subCategory       String?  // 소분류
  tags              String[] @default([])
  isRecurring       Boolean  @default(false)
  recurringPattern  String?  // daily, weekly, monthly, yearly

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  person            Person   @relation(fields: [personId], references: [id])
  card              Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([accountId])
  @@index([personId])
  @@index([cardId])
  @@index([date])
  @@index([type])
  @@index([mainCategory])
}

// 카테고리 (대분류/소분류)
model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  parentId  String?  // 대분류는 null, 소분류는 대분류 ID
  level     Int      @default(1) // 1: 대분류, 2: 소분류
  type      String   // income, expense
  icon      String?
  color     String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("CategoryHierarchy")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([parentId])
  @@unique([userId, name, parentId])
}

// 카드 사용 기록
model CardUsage {
  id          String   @id @default(cuid())
  userId      String
  cardId      String
  amount      Float
  merchant    String   // 가맹점
  date        DateTime
  status      String   @default("completed") // pending, completed, cancelled
  isPaymentDue Boolean @default(true)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([cardId])
  @@index([date])
}

// 신용카드 결제 (신용카드 사용액을 통장에서 결제)
model CardPayment {
  id              String   @id @default(cuid())
  userId          String
  cardId          String
  accountId       String
  totalAmount     Float    // 결제할 총액
  paidAmount      Float    @default(0) // 실제 결제된 금액
  status          String   @default("pending") // pending, completed
  paymentDate     DateTime
  transactionId   String?  // 결제 거래 ID

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card            Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([cardId])
  @@index([status])
}

# Server
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/money_db"

# 이 프로세스가 데이터베이스에 열어 둘 연결 수.
#
# **인스턴스가 하나면 비워 두어도 된다.** 비어 있으면 Prisma 가 코어 × 2 + 1 로 정한다.
# 인스턴스를 늘리면 그 값이 프로세스마다 따로 잡혀 그 수만큼 곱해진다 -- 코어 8개짜리에서
# 4 인스턴스면 68개이고, 포스트그레스의 기본 상한(max_connections 100)에 금세 닿는다.
# 그때 나는 오류("sorry, too many clients already")는 마침 질의하던 요청 쪽에서 터져
# 원인이 풀 설정이라는 것이 드러나지 않는다.
#
# 어림값: (max_connections - 여유) / 인스턴스 수. 뜰 때 로그에 실제 값이 찍힌다.
# DATABASE_CONNECTION_LIMIT=10

# JWT
# 32자 이상이어야 서버가 뜬다. 기본값은 없다.
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis
# 실시간 알림(SSE)을 인스턴스 사이로 나르는 통로다.
#
# **인스턴스가 하나면 비워 두어도 된다.** 비어 있으면 신호가 그 프로세스 안에서만 돌고,
# 붙어 있는 화면은 그대로 즉시 따라붙는다. 인스턴스를 둘 이상 띄우면 반드시 넣어야
# 한다 -- 그러지 않으면 웹에서 고친 것이 다른 인스턴스에 붙은 앱에 즉시 닿지 않는다
# (다음 동기화까지 늦어질 뿐, 값이 틀리지는 않는다).
#
# 나르는 것이 하나 더 있다. **요청 상한도 이 레디스에서 함께 센다.**
# 없으면 프로세스마다 따로 세어져 인스턴스 수만큼 한도가 느슨해진다(로그인 경로가 특히
# 그렇다). 레디스가 죽으면 그 메모리 계수로 되돌아가고 요청은 막히지 않는다.
#
# 개발 중에 켜 보려면: docker compose up -d redis
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=debug

# Google OAuth
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급한 클라이언트 ID.
# 플랫폼별로 ID가 다르므로 콤마로 구분해 나열한다 (웹, iOS, Android...).
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com

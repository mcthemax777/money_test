# Server
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/money_db"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=debug

# Google OAuth
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급한 클라이언트 ID.
# 플랫폼별로 ID가 다르므로 콤마로 구분해 나열한다 (웹, iOS, Android...).
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com

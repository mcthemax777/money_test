{
  "name": "money-app",
  "version": "1.0.0",
  "description": "가계부 앱 - TypeScript 모노레포",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "api:dev": "turbo run dev --filter=@money/api",
    "api:build": "turbo run build --filter=@money/api"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}

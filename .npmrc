# React Native(Expo)의 릴리스 번들링은 gradle 이 부르는 node 프로세스 안에서 돈다.
# 그 babel 은 프리셋과 플러그인을 이름으로 찾는데, pnpm 기본 배치에서는 그것들이
# packages/app/node_modules 에 없어 "Cannot find module 'babel-preset-expo'" 로 깨진다.
# 도구 계열만 루트 node_modules 로 끌어올려 어디서든 보이게 한다.
# (node-linker=hoisted 로 전부 펼치면 web 의 react 18 과 app 의 react 19 가 섞여
#  Next 빌드가 useContext null 로 깨진다.)
public-hoist-pattern[]=@babel/*
public-hoist-pattern[]=babel-*
public-hoist-pattern[]=metro*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=@react-native/*
# 네이티브 모듈은 그것을 쓰는 다른 꾸러미(lucide-react-native 등)에서도 보여야 한다.
# pnpm 기본 배치에서는 서로의 node_modules 를 볼 수 없어 번들링이 깨진다.
public-hoist-pattern[]=react-native-svg
